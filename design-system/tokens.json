{
  "color-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1020, 0.1020, 0.1020],
      "hex": "#1a1a1a"
    },
    "$description": "Primary body text color, used on color-bg. Contrast ratio ~17.4:1."
  },
  "color-bg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Default page/surface background."
  },
  "color-surface": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.9725, 0.9804, 0.9882],
      "hex": "#f8fafc"
    },
    "$description": "Slightly recessed surface, distinct from color-bg, used for cards."
  },
  "color-primary": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1137, 0.3059, 0.8471],
      "hex": "#1d4ed8"
    },
    "$description": "Brand/interactive accent color. Meets 4.5:1 as text on color-bg (~6.7:1)."
  },
  "color-on-primary": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Text/icon color placed on top of color-primary."
  },
  "color-muted": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.2784, 0.3333, 0.4118],
      "hex": "#475569"
    },
    "$description": "Secondary/muted text color."
  },
  "color-border": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8863, 0.9098, 0.9412],
      "hex": "#e2e8f0"
    },
    "$description": "Default hairline border color."
  },
  "color-danger": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8627, 0.1490, 0.1490],
      "hex": "#dc2626"
    },
    "$description": "Destructive/error accent color."
  },

  "space-1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
  "space-2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
  "space-3": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
  "space-4": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },

  "radius-sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
  "radius-md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
  "radius-lg": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },

  "font-size-sm": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
  "font-size-md": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
  "font-size-lg": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },

  "border-width-sm": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
  "border-width-md": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },

  "font-family-base": {
    "$type": "fontFamily",
    "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "font-weight-regular": { "$type": "fontWeight", "$value": 400 },
  "font-weight-bold": { "$type": "fontWeight", "$value": 600 },
  "line-height-base": { "$type": "number", "$value": 1.5 },

  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-on-primary}"
  },
  "button-primary-border-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-primary}"
  },

  "card-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-border-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },

  "chip-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "chip-default-foreground": {
    "$type": "color",
    "$value": "{color-muted}"
  },
  "chip-default-border-radius": {
    "$type": "dimension",
    "$value": "{radius-sm}"
  },

  "input-default-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "input-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "input-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}"
  },
  "input-default-border-radius": {
    "$type": "dimension",
    "$value": "{radius-sm}"
  }
}
